# Slack incoming webhook URL.
# Create one at https://api.slack.com/apps -> Your App -> Incoming Webhooks.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Public base URL where the nginx service in this compose stack is reachable
# from Slack's image-fetching servers. Slack must be able to GET this over the
# public internet, so this is *your* reverse-proxy / tunnel / domain — not
# localhost. The poster appends "/<filename>" to it.
#
# Example:        https://memes.example.com
# Slack will GET: https://memes.example.com/cat.jpg
PUBLIC_MEMES_URL=https://memes.example.com

# Host port to bind the nginx service to. Put your reverse proxy in front of this.
NGINX_PORT=8080

# Timezone for the cron schedule. Friday 16:00 fires in this zone.
TZ=Europe/Brussels
