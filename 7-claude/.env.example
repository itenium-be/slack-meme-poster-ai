# Slack incoming webhook URL.
# Create one at https://api.slack.com/apps -> Your App -> Incoming Webhooks.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Public base URL where the nginx service is reachable from Slack's image
# fetcher. Must be publicly resolvable — the ISP router forwards 4001 -> the
# docker host on 4001, and nginx in this compose stack listens on 4001.
# The poster appends "/<filename>" to it.
#
# Example:        http://itenium-test.synology.me:4001
# Slack will GET: http://itenium-test.synology.me:4001/cat.jpg
PUBLIC_MEMES_URL=http://itenium-test.synology.me:4001

# Timezone for the cron schedule. Friday 16:00 fires in this zone.
TZ=Europe/Brussels
